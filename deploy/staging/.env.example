PRAXIS_STAGE=staging
PRAXIS_PUBLIC_BASE_PATH=/praxis
PRAXIS_SUPABASE_URL=https://your-project.supabase.co
PRAXIS_SUPABASE_ANON_KEY=your-supabase-publishable-key
PRAXIS_AI_API_BASE_URL=https://app.yourdomain.com/praxis/praxis-ai
PRAXIS_AI_API_TOKEN=replace-with-shared-token

MANAGED_AI_PORT=8787
MANAGED_AI_SHARED_TOKEN=replace-with-shared-token
OPENAI_API_KEY=
OPENAI_PROVIDER_NAME=OpenAI
OPENAI_API_PROTOCOL=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000

# MiniMax OpenAI-compatible example:
# OPENAI_PROVIDER_NAME=MiniMax
# OPENAI_BASE_URL=https://api.minimax.io/v1
# OPENAI_MODEL=MiniMax-M2.7-highspeed

# MiniMax Anthropic-compatible example:
# OPENAI_PROVIDER_NAME=MiniMax
# OPENAI_API_PROTOCOL=anthropic
# OPENAI_BASE_URL=https://api.minimaxi.com/anthropic
# OPENAI_MODEL=MiniMax-M2.7

WEB_PORT=8080
